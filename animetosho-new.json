{
    "id": "animetosho-new",
    "name": "AnimeTosho (NEW)",
    "version": "2.4.4",
    "language": "typescript",
    "type": "anime-torrent-provider",
    "description": "Integrates Anime Tosho (NEW) as a torrent streaming provider for Seanime.",
    "author": "Faddix, Island",
    "icon": "https://raw.githubusercontent.com/faddix/seanime-animetosho-new/main/src/animetosho-new-logo.png",
    "lang": "multi",
    "userConfig": {
        "version": 3,
        "requiresConfig": false,
        "fields": [
            {
                "type": "text",
                "name": "jsonURL",
                "label": "Feed URL",
                "default": "https://feed.animetosho.xyz/feed/json"
            },
            {
                "type": "text",
                "name": "maxPages",
                "label": "Max pages to fetch",
                "default": "3"
            },
            {
                "type": "select",
                "name": "searchOrder",
                "label": "Search fetch order",
                "default": "size-d",
                "options": [
                    {
                        "value": "size-a",
                        "label": "Size (smallest first)"
                    },
                    {
                        "value": "size-d",
                        "label": "Size (largest first)"
                    },
                    {
                        "value": "date-a",
                        "label": "Date (oldest first)"
                    },
                    {
                        "value": "date-d",
                        "label": "Date (newest first)"
                    }
                ]
            },
            {
                "type": "select",
                "name": "batchSearchOrder",
                "label": "Batch fetch order",
                "default": "size-d",
                "options": [
                    {
                        "value": "size-a",
                        "label": "Size (smallest first)"
                    },
                    {
                        "value": "size-d",
                        "label": "Size (largest first)"
                    },
                    {
                        "value": "date-a",
                        "label": "Date (oldest first)"
                    },
                    {
                        "value": "date-d",
                        "label": "Date (newest first)"
                    }
                ]
            },
            {
                "type": "select",
                "name": "singleEpisodeSearchOrder",
                "label": "Single episode fetch order",
                "default": "size-d",
                "options": [
                    {
                        "value": "size-a",
                        "label": "Size (smallest first)"
                    },
                    {
                        "value": "size-d",
                        "label": "Size (largest first)"
                    },
                    {
                        "value": "date-a",
                        "label": "Date (oldest first)"
                    },
                    {
                        "value": "date-d",
                        "label": "Date (newest first)"
                    }
                ]
            },
            {
                "type": "select",
                "name": "latestTorrentsOrder",
                "label": "Latest torrents fetch order",
                "default": "date-d",
                "options": [
                    {
                        "value": "size-a",
                        "label": "Size (smallest first)"
                    },
                    {
                        "value": "size-d",
                        "label": "Size (largest first)"
                    },
                    {
                        "value": "date-a",
                        "label": "Date (oldest first)"
                    },
                    {
                        "value": "date-d",
                        "label": "Date (newest first)"
                    }
                ]
            }
        ]
    },
    "payloadURI": "https://raw.githubusercontent.com/faddix/seanime-animetosho-new/main/animetosho-new.ts",
    "manifestURI": "https://raw.githubusercontent.com/faddix/seanime-animetosho-new/main/animetosho-new.json"
}